<!--
/* Hallmark · macrostructure: Index-First · genre: editorial (loud) · theme: Carnival custom drop "Delta Blue" */
話題式週報：期數列表首頁。跟 topic_issue.html.jinja 共用同一套 Carnival 藍設計系統，
拿掉了列表用不到的手風琴／蓋章／跑馬燈互動，保留一致的字體、色彩、硬邊陰影語彙。
-->
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ newsletter_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800&family=Noto+Sans+TC:wght@700;900&family=IBM+Plex+Sans:wght@400;500&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root {
    --color-paper:   #eef1f4;
    --color-paper-2: #ffffff;
    --color-paper-3: #dde4ea;
    --color-ink:     #1c2b38;
    --color-ink-2:   #33424f;
    --color-muted:   #5a6672;
    --color-accent:      #1f4e8c;
    --color-accent-ink:  #ffffff;
    --color-accent-2:    #c07a2a;
    --color-focus:   #1f4e8c;
    --font-display: "Noto Sans TC", "Microsoft JhengHei", sans-serif;
    --font-body:    "IBM Plex Sans", ui-sans-serif, "PingFang TC", "Noto Sans TC", sans-serif;
    --font-label:   "JetBrains Mono", ui-monospace, monospace;
    --page-gutter: clamp(1.25rem, 4vw, 3rem);
    --shell: 46rem;
  }
  * { box-sizing: border-box; }
  html, body { overflow-x: clip; margin: 0; padding: 0; }
  body { background: var(--color-paper); color: var(--color-ink); font-family: var(--font-body); }
  .shell { max-width: var(--shell); margin-inline: auto; padding-inline: var(--page-gutter); }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  h1 { font-family: var(--font-display); font-weight: 800; font-variation-settings: "wdth" 110, "wght" 800; letter-spacing: 0.01em; line-height: 0.96;  }

  .halftone { display: none; height: 14px; background-image: radial-gradient(var(--color-ink) 1.5px, transparent 1.5px); background-size: 10px 10px; opacity: 0.5; }

  .masthead { background: var(--color-accent); color: var(--color-accent-ink); padding: 3rem var(--page-gutter) 2.5rem; }
  .masthead-inner { max-width: var(--shell); margin: 0 auto; }
  .masthead .eyebrow { font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.1em; margin: 0 0 0.6rem; }
  .masthead h1 { margin: 0; font-size: clamp(1.9rem, 3.6vw + 1rem, 3rem); }
  .masthead p { margin: 1rem 0 0; font-size: 0.9rem; line-height: 1.6; color: color-mix(in oklch, var(--color-accent-ink) 82%, transparent); max-width: 56ch; }

  .ornament-row { display: none; text-align: center; color: var(--color-accent-2); letter-spacing: 0.6em; padding: 1.5rem 0; font-size: 0.9rem; }

  .issue-index { max-width: var(--shell); margin: 0 auto; padding: 0 var(--page-gutter) 4rem; display: flex; flex-direction: column; gap: 1rem; }
  .issue-card {
    display: block; background: var(--color-paper-2); border: 1px solid #d8dee4;
    box-shadow: 0 2px 8px rgba(28,43,56,0.14); padding: 1.1rem 1.4rem;
    transition: transform 120ms ease-out, box-shadow 120ms ease-out;
  }
  .issue-card:hover { transform: translate(-1px, -1px); box-shadow: 0 2px 8px rgba(28,43,56,0.10); }
  .issue-card:active { transform: translate(2px, 2px); box-shadow: 0 1px 2px rgba(28,43,56,0.10); }
  .issue-card-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .issue-card-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.1rem, 1.6vw + 0.7rem, 1.5rem);  }
  .issue-card-date { font-family: var(--font-label); font-size: 0.8rem; color: var(--color-muted); white-space: nowrap; }
  .issue-card-cadence { font-family: var(--font-label); font-size: 0.7rem; border: 1px solid var(--color-ink); padding: 0.1em 0.5em; white-space: nowrap; }
  .issue-card-cadence.weekly { background: var(--color-ink); color: var(--color-paper); }

  /* 首頁領域卡片（2026-08-26 改版主視覺）。 */
  .module-board { max-width: 52rem; margin: 0 auto; padding: 0 var(--page-gutter) 2rem; }
  .board-title { font-family: var(--font-display); font-weight: 800;  font-size: clamp(1.4rem, 2.4vw + 0.8rem, 2rem); margin: 0; color: var(--color-ink); border-bottom: 4px solid var(--color-accent); display: inline-block; padding-bottom: 0.15em; }
  .board-group-label { font-family: var(--font-label); font-size: 0.72rem; letter-spacing: 0.08em; color: var(--color-muted); margin: 1rem 0 0.5rem; }
  .module-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr)); gap: 0.8rem; }
  .module-card { display: flex; flex-direction: column; gap: 0.3rem; background: var(--color-paper-2); border: 1px solid #d8dee4; box-shadow: 0 1px 4px rgba(28,43,56,0.10); padding: 0.8rem 0.95rem; transition: transform 120ms ease-out, box-shadow 120ms ease-out; }
  .module-card:hover { transform: translate(-1px, -1px); box-shadow: 0 2px 8px rgba(28,43,56,0.14); }
  .module-card.domain { border-color: var(--color-accent); }
  .module-card-name { font-family: var(--font-display); font-weight: 800; font-size: 1.05rem;  }
  .module-card.domain .module-card-name { color: var(--color-accent); }
  .module-card-count { font-family: var(--font-label); font-size: 0.72rem; color: var(--color-muted); }
  .module-card-latest { font-size: 0.76rem; line-height: 1.5; color: var(--color-ink-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cal-section-title { margin-top: 0.5rem; }

  /* 月曆：一週從週日起算（跟週報的週定義一致）。日曆是首頁主視覺，
     底下保留原本的期數列表當備援。 */
  .cal-wrap { max-width: 52rem; margin: 0 auto; padding: 0 var(--page-gutter) 2.5rem; }
  .cal-month { margin-bottom: 2.5rem; }
  .cal-title { font-family: var(--font-display); font-weight: 800;  font-size: clamp(1.4rem, 2.4vw + 0.8rem, 2rem); margin: 0 0 0.9rem; }
  .cal-board { border: 1px solid #d8dee4; box-shadow: 0 2px 8px rgba(28,43,56,0.10); background: var(--color-paper-2); overflow-x: auto; }
  .cal-head, .cal-week { display: grid; grid-template-columns: repeat(7, minmax(4.2rem, 1fr)); }
  .cal-head { background: var(--color-ink); color: var(--color-accent-ink); }
  .cal-head span { font-family: var(--font-label); font-size: 0.72rem; letter-spacing: 0.08em; text-align: center; padding: 0.45em 0; }
  .cal-head span:first-child { color: var(--color-accent-2); }
  .cal-cell { min-height: 5.2rem; border-top: 1px solid var(--color-paper-3); border-left: 1px solid var(--color-paper-3); padding: 0.35rem 0.4rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .cal-week .cal-cell:first-child { border-left: none; }
  .cal-cell.out { background: color-mix(in oklch, var(--color-paper-3) 55%, var(--color-paper-2)); }
  .cal-cell.out .cal-day { opacity: 0.35; }
  .cal-cell.today { outline: 3px solid var(--color-accent); outline-offset: -3px; }
  .cal-day { font-family: var(--font-label); font-size: 0.78rem; color: var(--color-muted); }
  .cal-chip { display: block; font-family: var(--font-label); font-size: 0.68rem; line-height: 1.35; border: 1px solid #c9d2da; background: var(--color-paper); padding: 0.18em 0.4em; box-shadow: 2px 2px 0 var(--color-ink); transition: transform 100ms ease-out, box-shadow 100ms ease-out; }
  .cal-chip:hover { transform: translate(-1px, -1px); box-shadow: 0 1px 4px rgba(28,43,56,0.10); background: var(--color-accent); color: var(--color-accent-ink); }
  .cal-chip:active { transform: translate(1px, 1px); box-shadow: 0 1px 2px rgba(28,43,56,0.10); }
  .cal-chip.weekly { background: var(--color-ink); color: var(--color-paper); }
  .cal-chip.weekly:hover { background: var(--color-accent); }
  .cal-legend { display: flex; gap: 1.2rem; margin-top: 0.7rem; font-family: var(--font-label); font-size: 0.72rem; color: var(--color-muted); }
  .cal-legend .cal-chip { display: inline-block; box-shadow: none; cursor: default; }
  .cal-legend .cal-chip:hover { transform: none; background: var(--color-paper); color: inherit; }
  .cal-legend .cal-chip.weekly:hover { background: var(--color-ink); color: var(--color-paper); }

  .list-heading { max-width: var(--shell); margin: 0 auto; padding: 0 var(--page-gutter) 0.9rem; font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.1em; color: var(--color-muted); }

  .empty { max-width: var(--shell); margin: 0 auto; padding: 3rem var(--page-gutter); color: var(--color-muted); }
  .empty p { margin: 0 0 0.75rem; line-height: 1.6; }
  .empty code { font-family: var(--font-label); background: var(--color-paper-2); border: 1px solid var(--color-paper-3); padding: 0.15em 0.5em; }

  .foot { background: var(--color-ink); color: var(--color-accent-ink); padding: 1.5rem var(--page-gutter) 2.5rem; }
  .foot-inner { max-width: var(--shell); margin: 0 auto; font-size: 0.8rem; line-height: 1.7; opacity: 0.85; }
</style>
</head>
<body>

<div class="halftone" aria-hidden="true"></div>

<header class="masthead">
  <div class="masthead-inner">
    <p class="eyebrow">DELTA AI TREND DAILY</p>
    <h1>{{ newsletter_name }}</h1>
    <p>每天更新，用一杯咖啡的時間，帶你發掘最值得一看的 AI 動態。</p>
  </div>
</header>

<div class="ornament-row" aria-hidden="true">✱ ✱ ✱ ✱</div>

{% if module_overview %}
{# 首頁主視覺：領域卡片（2026-08-26 改版）。讀者是帶著職能來的，法務的人
   點法務、能源的人點能源，日期是次要資訊，月曆降到下面當出刊紀錄。 #}
<section class="module-board" aria-label="依領域瀏覽">
  {# 標題下面刻意不放說明句：原本那句在解釋資料模型（專屬頁面、一篇文章
     屬於幾個領域），讀者點一次就懂的事不用先教（2026-08-28 使用者定調）。 #}
  <h2 class="board-title">選你的領域</h2>
  {# 特輯放在台達本業上面（2026-08-28 使用者要求）。 #}
  {% if release_overview %}
  <p class="board-group-label">特輯</p>
  <div class="module-card-grid">
    <a class="module-card domain" href="/releases">
      <span class="module-card-name">模型與工具發佈</span>
      <span class="module-card-count">{{ release_overview.count }} 則</span>
      {% if release_overview.latest %}<span class="module-card-latest">{{ release_overview.latest.date }}｜{% if release_overview.latest.vendor %}{{ release_overview.latest.vendor }}：{% endif %}{{ release_overview.latest.title }}</span>{% endif %}
    </a>
  </div>
  {% endif %}
  <p class="board-group-label">事業領域</p>
  <div class="module-card-grid">
    {% for m in module_overview.domain %}
    <a class="module-card domain" href="/modules/{{ m.id }}">
      <span class="module-card-name">{{ m.name }}</span>
      <span class="module-card-count">{{ m.count }} 篇</span>
      {% if m.latest %}<span class="module-card-latest">{{ m.latest.date }}｜{{ m.latest.title }}</span>{% endif %}
    </a>
    {% endfor %}
  </div>
  <p class="board-group-label">工作職能</p>
  <div class="module-card-grid">
    {% for m in module_overview.functional %}
    <a class="module-card" href="/modules/{{ m.id }}">
      <span class="module-card-name">{{ m.name }}</span>
      <span class="module-card-count">{{ m.count }} 篇</span>
      {% if m.latest %}<span class="module-card-latest">{{ m.latest.date }}｜{{ m.latest.title }}</span>{% endif %}
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{# 月曆（出刊紀錄）跟期數列表 2026-08-28 拿掉：使用者定調首頁只留
   「選你的領域」。單期頁的網址（/issues/<id>）都還在，只是首頁不再列。 #}
<footer class="foot">
  <div class="foot-inner"><p>{{ newsletter_name }}．僅供台達內部參考。</p></div>
</footer>

</body>
</html>
