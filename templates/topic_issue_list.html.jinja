<!--
/* Hallmark · macrostructure: Index-First · genre: editorial (loud) · theme: Carnival custom drop "Delta Blue" */
話題式週報：期數列表首頁。跟 topic_issue.html.jinja 共用同一套 Carnival 藍設計系統，
拿掉了列表用不到的手風琴／蓋章／跑馬燈互動，保留一致的字體、色彩、硬邊陰影語彙。
-->
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ newsletter_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800&family=Noto+Sans+TC:wght@700;900&family=IBM+Plex+Sans:wght@400;500&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root {
    --color-paper:   #e8e4da;
    --color-paper-2: #fbfaf6;
    --color-paper-3: #ece7dc;
    --color-ink:     #1a1a1a;
    --color-ink-2:   #44474a;
    --color-muted:   #8a8578;
    --color-accent:      #8a5a1a;
    --color-accent-ink:  #fdf6ef;
    --color-accent-2:    #c07a2a;
    --color-focus:   #8a5a1a;
    --font-display: "Noto Sans TC", "Microsoft JhengHei", sans-serif;
    --font-body:    "IBM Plex Sans", ui-sans-serif, "PingFang TC", "Noto Sans TC", sans-serif;
    --font-label:   "JetBrains Mono", ui-monospace, monospace;
    --page-gutter: clamp(1.25rem, 4vw, 3rem);
    --shell: 46rem;
  }
  * { box-sizing: border-box; }
  html, body { overflow-x: clip; margin: 0; padding: 0; }
  body { background: var(--color-paper); color: var(--color-ink); font-family: var(--font-body); }
  .shell { max-width: var(--shell); margin-inline: auto; padding-inline: var(--page-gutter); }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  h1 { font-family: var(--font-display); font-weight: 800; font-variation-settings: "wdth" 110, "wght" 800; letter-spacing: 0.01em; line-height: 0.96;  }

  .halftone { display: none; height: 14px; background-image: radial-gradient(var(--color-ink) 1.5px, transparent 1.5px); background-size: 10px 10px; opacity: 0.5; }

  .masthead { background: var(--color-accent); color: var(--color-accent-ink); padding: 3rem var(--page-gutter) 2.5rem; }
  .masthead-inner { max-width: var(--shell); margin: 0 auto; }
  .masthead .eyebrow { font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.1em; margin: 0 0 0.6rem; }
  .masthead h1 { margin: 0; font-size: clamp(1.9rem, 3.6vw + 1rem, 3rem); }
  .masthead p { margin: 1rem 0 0; font-size: 0.9rem; line-height: 1.6; color: color-mix(in oklch, var(--color-accent-ink) 82%, transparent); max-width: 56ch; }
  .masthead-nav { font-family: var(--font-label); font-size: 0.78rem; }
  .masthead-nav a { color: var(--color-accent-ink); text-decoration: none; border-bottom: 1px solid color-mix(in oklch, var(--color-accent-ink) 50%, transparent); padding-bottom: 1px; }

  .ornament-row { display: none; text-align: center; color: var(--color-accent-2); letter-spacing: 0.6em; padding: 1.5rem 0; font-size: 0.9rem; }

  .issue-index { max-width: var(--shell); margin: 0 auto; padding: 0 var(--page-gutter) 4rem; display: flex; flex-direction: column; gap: 1rem; }
  .issue-card {
    display: block; background: var(--color-paper-2); border: 1px solid #ddd5c4;
    box-shadow: 0 2px 8px rgba(40,36,28,0.14); padding: 1.1rem 1.4rem;
    transition: transform 120ms ease-out, box-shadow 120ms ease-out;
  }
  .issue-card:hover { transform: translate(-1px, -1px); box-shadow: 0 2px 8px rgba(40,36,28,0.10); }
  .issue-card:active { transform: translate(2px, 2px); box-shadow: 0 1px 2px rgba(40,36,28,0.10); }
  .issue-card-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .issue-card-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.1rem, 1.6vw + 0.7rem, 1.5rem);  }
  .issue-card-date { font-family: var(--font-label); font-size: 0.8rem; color: var(--color-muted); white-space: nowrap; }
  .issue-card-cadence { font-family: var(--font-label); font-size: 0.7rem; border: 1px solid var(--color-ink); padding: 0.1em 0.5em; white-space: nowrap; }
  .issue-card-cadence.weekly { background: var(--color-ink); color: var(--color-paper); }

  /* 2026-09-18 新聞流改版：卡片牆樣式退場，改用跟領域頁同款的 chip 列
     與時間軸（無模板繼承，樣式對照 topic_module_list.html.jinja）。 */
  .feed-nav { max-width: var(--shell); margin: 0 auto; padding: 1.2rem var(--page-gutter) 0.2rem; }
  .module-nav-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.7rem; }
  .module-chip { font-family: var(--font-label); font-size: 0.72rem; border: 1px solid #ddd5c4; background: var(--color-paper-2); padding: 0.25em 0.6em; }
  .module-chip:hover { background: var(--color-accent); color: var(--color-accent-ink); }
  .module-chip.active { background: var(--color-ink); color: var(--color-paper); }
  .module-chip.dim { color: var(--color-muted); }
  .timeline { max-width: var(--shell); margin: 0 auto; padding: 1rem var(--page-gutter) 4rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; }
  @media (max-width: 40rem) { .timeline { grid-template-columns: 1fr; } }
  .timeline-date { grid-column: 1 / -1; font-family: var(--font-label); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; color: var(--color-accent); margin: 1rem 0 -0.2rem; display: flex; align-items: center; gap: 0.7em; }
  .timeline-date::after { content: ""; flex: 1; border-top: 2px solid var(--color-paper-3); }
  .timeline-date:first-child { margin-top: 0.2rem; }
  .entry { display: block; background: var(--color-paper-2); border: 1px solid #ddd5c4; box-shadow: 0 1px 4px rgba(40,36,28,0.10); padding: 1rem 1.2rem; transition: transform 120ms ease-out, box-shadow 120ms ease-out; }
  .entry:hover { transform: translate(-1px, -1px); box-shadow: 0 2px 8px rgba(40,36,28,0.14); }
  .entry h2 { margin: 0 0 0.25rem; font-family: var(--font-display); font-size: 1.05rem; line-height: 1.4; }
  .entry .subhead { margin: 0; font-size: 0.85rem; line-height: 1.55; color: var(--color-ink-2); }
  .empty { max-width: var(--shell); margin: 0 auto; padding: 3rem var(--page-gutter); color: var(--color-muted); }
  .cal-section-title { margin-top: 0.5rem; }

  /* 月曆：一週從週日起算（跟週報的週定義一致）。日曆是首頁主視覺，
     底下保留原本的期數列表當備援。 */
  .cal-wrap { max-width: 52rem; margin: 0 auto; padding: 0 var(--page-gutter) 2.5rem; }
  .cal-month { margin-bottom: 2.5rem; }
  .cal-title { font-family: var(--font-display); font-weight: 800;  font-size: clamp(1.4rem, 2.4vw + 0.8rem, 2rem); margin: 0 0 0.9rem; }
  .cal-board { border: 1px solid #ddd5c4; box-shadow: 0 2px 8px rgba(40,36,28,0.10); background: var(--color-paper-2); overflow-x: auto; }
  .cal-head, .cal-week { display: grid; grid-template-columns: repeat(7, minmax(4.2rem, 1fr)); }
  .cal-head { background: var(--color-ink); color: var(--color-accent-ink); }
  .cal-head span { font-family: var(--font-label); font-size: 0.72rem; letter-spacing: 0.08em; text-align: center; padding: 0.45em 0; }
  .cal-head span:first-child { color: var(--color-accent-2); }
  .cal-cell { min-height: 5.2rem; border-top: 1px solid var(--color-paper-3); border-left: 1px solid var(--color-paper-3); padding: 0.35rem 0.4rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .cal-week .cal-cell:first-child { border-left: none; }
  .cal-cell.out { background: color-mix(in oklch, var(--color-paper-3) 55%, var(--color-paper-2)); }
  .cal-cell.out .cal-day { opacity: 0.35; }
  .cal-cell.today { outline: 3px solid var(--color-accent); outline-offset: -3px; }
  .cal-day { font-family: var(--font-label); font-size: 0.78rem; color: var(--color-muted); }
  .cal-chip { display: block; font-family: var(--font-label); font-size: 0.68rem; line-height: 1.35; border: 1px solid #ddd5c4; background: var(--color-paper); padding: 0.18em 0.4em; box-shadow: 2px 2px 0 var(--color-ink); transition: transform 100ms ease-out, box-shadow 100ms ease-out; }
  .cal-chip:hover { transform: translate(-1px, -1px); box-shadow: 0 1px 4px rgba(40,36,28,0.10); background: var(--color-accent); color: var(--color-accent-ink); }
  .cal-chip:active { transform: translate(1px, 1px); box-shadow: 0 1px 2px rgba(40,36,28,0.10); }
  .cal-chip.weekly { background: var(--color-ink); color: var(--color-paper); }
  .cal-chip.weekly:hover { background: var(--color-accent); }
  .cal-legend { display: flex; gap: 1.2rem; margin-top: 0.7rem; font-family: var(--font-label); font-size: 0.72rem; color: var(--color-muted); }
  .cal-legend .cal-chip { display: inline-block; box-shadow: none; cursor: default; }
  .cal-legend .cal-chip:hover { transform: none; background: var(--color-paper); color: inherit; }
  .cal-legend .cal-chip.weekly:hover { background: var(--color-ink); color: var(--color-paper); }

  .list-heading { max-width: var(--shell); margin: 0 auto; padding: 0 var(--page-gutter) 0.9rem; font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.1em; color: var(--color-muted); }

  .empty { max-width: var(--shell); margin: 0 auto; padding: 3rem var(--page-gutter); color: var(--color-muted); }
  .empty p { margin: 0 0 0.75rem; line-height: 1.6; }
  .empty code { font-family: var(--font-label); background: var(--color-paper-2); border: 1px solid var(--color-paper-3); padding: 0.15em 0.5em; }

  .foot { background: var(--color-ink); color: var(--color-accent-ink); padding: 1.5rem var(--page-gutter) 2.5rem; }
  .foot-inner { max-width: var(--shell); margin: 0 auto; font-size: 0.8rem; line-height: 1.7; opacity: 0.85; }
</style>
</head>
<body>

<div class="halftone" aria-hidden="true"></div>

<header class="masthead">
  <div class="masthead-inner">
    <p class="eyebrow">DELTA AI TREND DAILY</p>
    <h1>{{ newsletter_name }}</h1>
    <p>每天更新，用一杯咖啡的時間，帶你發掘最值得一看的 AI 動態。</p>
    <p class="masthead-nav"><a href="/archive">出刊紀錄</a> ◆ <a href="/sources">來源清單</a></p>
  </div>
</header>

<div class="ornament-row" aria-hidden="true">✱ ✱ ✱ ✱</div>

{# 2026-09-18 新聞流改版（使用者選案）：首頁是全領域最新文章的時間軸，
   「全部」就是本頁，領域 chip 連到各領域頁（同款時間軸），特輯 chip 連
   發佈頁。卡片牆（2026-08-26 版）退場。 #}
<nav class="feed-nav" aria-label="領域篩選">
  <div class="module-nav-row">
    <a class="module-chip active" href="/">全部</a>
    {% for m in module_overview.domain + module_overview.functional %}
    <a class="module-chip{% if not m.count %} dim{% endif %}" href="/modules/{{ m.id }}">{{ m.name }}</a>
    {% endfor %}
    {% if release_overview %}<a class="module-chip" href="/releases">模型與工具發佈</a>{% endif %}
  </div>
</nav>

{% if feed %}
<section class="timeline" aria-label="最新文章">
  {% for e in feed %}
  {% if loop.changed(e.issue_date) %}
  <p class="timeline-date">{{ e.issue_date[5:7] | int }}/{{ e.issue_date[8:10] | int }}</p>
  {% endif %}
  <div class="entry">
    <a href="/issues/{{ e.issue_id }}/topics/{{ e.generated_id }}">
      <h2>{{ e.headline }}</h2>
      {% if e.subhead %}<p class="subhead">{{ e.subhead }}</p>{% endif %}
    </a>
  </div>
  {% endfor %}
</section>
{% else %}
<div class="empty"><p>還沒有出刊文章。</p></div>
{% endif %}

<footer class="foot">
  <div class="foot-inner"><p>{{ newsletter_name }}．僅供台達內部參考。</p></div>
</footer>

{# 彈層閱讀：跟 topic_module_list.html.jinja 同一段（無模板繼承，改的話
   三處同步：這裡、module_list、issue）。 #}
<div class="reader-overlay" id="reader" hidden>
  <div class="reader-panel">
    <button class="reader-close" aria-label="關閉">✕</button>
    <iframe class="reader-frame" id="reader-frame" title="全文"></iframe>
  </div>
</div>
<style>
  .reader-overlay { position: fixed; inset: 0; background: rgba(24,30,36,0.55); z-index: 50; }
  .reader-panel { position: absolute; top: 3vh; left: 50%; transform: translateX(-50%);
                  width: min(720px, 94vw); height: 94vh; background: #fff;
                  box-shadow: 0 12px 48px rgba(0,0,0,0.35); }
  .reader-close { position: absolute; top: 0; right: 0; z-index: 2; border: 0; cursor: pointer;
                  background: rgba(24,30,36,0.85); color: #fff; font-size: 1rem; line-height: 1;
                  padding: 0.55em 0.75em; }
  .reader-frame { width: 100%; height: 100%; border: 0; display: block; }
</style>
<script>
(function () {
  var overlay = document.getElementById('reader');
  var frame = document.getElementById('reader-frame');
  function openReader(url) {
    frame.src = url;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    history.pushState({ reader: true }, '', url);
  }
  function closeReader(viaHistory) {
    overlay.hidden = true;
    frame.src = 'about:blank';
    document.body.style.overflow = '';
    if (!viaHistory) history.back();
  }
  document.addEventListener('click', function (e) {
    var a = e.target.closest ? e.target.closest('a') : null;
    if (!a) return;
    var href = a.getAttribute('href') || '';
    if (/^\/issues\/\d+\/topics\/\d+/.test(href)) {
      e.preventDefault();
      openReader(href);
    }
  });
  overlay.addEventListener('click', function (e) { if (e.target === overlay) closeReader(false); });
  overlay.querySelector('.reader-close').addEventListener('click', function () { closeReader(false); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !overlay.hidden) closeReader(false);
  });
  window.addEventListener('popstate', function () { if (!overlay.hidden) closeReader(true); });
})();
</script>

</body>
</html>
