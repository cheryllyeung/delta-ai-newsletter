<!--
/* Hallmark · macrostructure: Index-First · genre: editorial (loud) · theme: Carnival custom drop "Delta Blue" */
話題式週報：期數列表首頁。跟 topic_issue.html.jinja 共用同一套 Carnival 藍設計系統，
拿掉了列表用不到的手風琴／蓋章／跑馬燈互動，保留一致的字體、色彩、硬邊陰影語彙。
-->
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ newsletter_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800&family=Noto+Sans+TC:wght@700;900&family=IBM+Plex+Sans:wght@400;500&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root {
    --color-paper:   oklch(93% 0.020 240);
    --color-paper-2: oklch(89% 0.024 238);
    --color-paper-3: oklch(83% 0.028 235);
    --color-ink:     oklch(16% 0.030 250);
    --color-ink-2:   oklch(28% 0.028 248);
    --color-muted:   oklch(46% 0.020 245);
    --color-accent:      oklch(58% 0.160 247);
    --color-accent-ink:  oklch(97% 0.010 240);
    --color-accent-2:    oklch(76% 0.150  75);
    --color-focus:   oklch(58% 0.160 247);
    --font-display: "Big Shoulders Display", "Noto Sans TC", sans-serif;
    --font-body:    "IBM Plex Sans", ui-sans-serif, "PingFang TC", "Noto Sans TC", sans-serif;
    --font-label:   "JetBrains Mono", ui-monospace, monospace;
    --page-gutter: clamp(1.25rem, 4vw, 3rem);
    --shell: 46rem;
  }
  * { box-sizing: border-box; }
  html, body { overflow-x: clip; margin: 0; padding: 0; }
  body { background: var(--color-paper); color: var(--color-ink); font-family: var(--font-body); }
  .shell { max-width: var(--shell); margin-inline: auto; padding-inline: var(--page-gutter); }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  h1 { font-family: var(--font-display); font-weight: 800; font-variation-settings: "wdth" 110, "wght" 800; letter-spacing: 0.01em; line-height: 0.96; text-transform: uppercase; }

  .halftone { height: 14px; background-image: radial-gradient(var(--color-ink) 1.5px, transparent 1.5px); background-size: 10px 10px; opacity: 0.5; }

  .masthead { background: var(--color-accent); color: var(--color-accent-ink); padding: 3rem var(--page-gutter) 2.5rem; }
  .masthead-inner { max-width: var(--shell); margin: 0 auto; }
  .masthead .eyebrow { font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.1em; margin: 0 0 0.6rem; }
  .masthead h1 { margin: 0; font-size: clamp(1.9rem, 3.6vw + 1rem, 3rem); }
  .masthead p { margin: 1rem 0 0; font-size: 0.9rem; line-height: 1.6; color: color-mix(in oklch, var(--color-accent-ink) 82%, transparent); max-width: 56ch; }

  .ornament-row { text-align: center; color: var(--color-accent-2); letter-spacing: 0.6em; padding: 1.5rem 0; font-size: 0.9rem; }

  .issue-index { max-width: var(--shell); margin: 0 auto; padding: 0 var(--page-gutter) 4rem; display: flex; flex-direction: column; gap: 1rem; }
  .issue-card {
    display: block; background: var(--color-paper-2); border: 2px solid var(--color-ink);
    box-shadow: 4px 4px 0 var(--color-ink); padding: 1.1rem 1.4rem;
    transition: transform 120ms ease-out, box-shadow 120ms ease-out;
  }
  .issue-card:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 var(--color-ink); }
  .issue-card:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--color-ink); }
  .issue-card-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .issue-card-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.1rem, 1.6vw + 0.7rem, 1.5rem); text-transform: uppercase; }
  .issue-card-date { font-family: var(--font-label); font-size: 0.8rem; color: var(--color-muted); white-space: nowrap; }
  .issue-card-cadence { font-family: var(--font-label); font-size: 0.7rem; border: 1px solid var(--color-ink); padding: 0.1em 0.5em; white-space: nowrap; }
  .issue-card-cadence.weekly { background: var(--color-ink); color: var(--color-paper); }

  /* 依領域瀏覽入口。 */
  .module-entry { max-width: 52rem; margin: 0 auto; padding: 0 var(--page-gutter) 1.4rem; }
  .module-entry-label { font-family: var(--font-label); font-size: 0.72rem; color: var(--color-muted); margin: 0 0 0.45rem; }
  .module-entry-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .module-entry-chip { font-family: var(--font-label); font-size: 0.72rem; border: 1.5px solid var(--color-ink); background: var(--color-paper-2); padding: 0.25em 0.6em; }
  .module-entry-chip.domain { border-color: var(--color-accent); color: var(--color-accent); font-weight: 700; }
  .module-entry-chip:hover { background: var(--color-accent); color: var(--color-accent-ink); border-color: var(--color-accent); }

  /* 月曆：一週從週日起算（跟週報的週定義一致）。日曆是首頁主視覺，
     底下保留原本的期數列表當備援。 */
  .cal-wrap { max-width: 52rem; margin: 0 auto; padding: 0 var(--page-gutter) 2.5rem; }
  .cal-month { margin-bottom: 2.5rem; }
  .cal-title { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.4rem, 2.4vw + 0.8rem, 2rem); margin: 0 0 0.9rem; }
  .cal-board { border: 2px solid var(--color-ink); box-shadow: 5px 5px 0 var(--color-ink); background: var(--color-paper-2); overflow-x: auto; }
  .cal-head, .cal-week { display: grid; grid-template-columns: repeat(7, minmax(4.2rem, 1fr)); }
  .cal-head { background: var(--color-ink); color: var(--color-accent-ink); }
  .cal-head span { font-family: var(--font-label); font-size: 0.72rem; letter-spacing: 0.08em; text-align: center; padding: 0.45em 0; }
  .cal-head span:first-child { color: var(--color-accent-2); }
  .cal-cell { min-height: 5.2rem; border-top: 1px solid var(--color-paper-3); border-left: 1px solid var(--color-paper-3); padding: 0.35rem 0.4rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .cal-week .cal-cell:first-child { border-left: none; }
  .cal-cell.out { background: color-mix(in oklch, var(--color-paper-3) 55%, var(--color-paper-2)); }
  .cal-cell.out .cal-day { opacity: 0.35; }
  .cal-cell.today { outline: 3px solid var(--color-accent); outline-offset: -3px; }
  .cal-day { font-family: var(--font-label); font-size: 0.78rem; color: var(--color-muted); }
  .cal-chip { display: block; font-family: var(--font-label); font-size: 0.68rem; line-height: 1.35; border: 1.5px solid var(--color-ink); background: var(--color-paper); padding: 0.18em 0.4em; box-shadow: 2px 2px 0 var(--color-ink); transition: transform 100ms ease-out, box-shadow 100ms ease-out; }
  .cal-chip:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 var(--color-ink); background: var(--color-accent); color: var(--color-accent-ink); }
  .cal-chip:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 var(--color-ink); }
  .cal-chip.weekly { background: var(--color-ink); color: var(--color-paper); }
  .cal-chip.weekly:hover { background: var(--color-accent); }
  .cal-legend { display: flex; gap: 1.2rem; margin-top: 0.7rem; font-family: var(--font-label); font-size: 0.72rem; color: var(--color-muted); }
  .cal-legend .cal-chip { display: inline-block; box-shadow: none; cursor: default; }
  .cal-legend .cal-chip:hover { transform: none; background: var(--color-paper); color: inherit; }
  .cal-legend .cal-chip.weekly:hover { background: var(--color-ink); color: var(--color-paper); }

  .list-heading { max-width: var(--shell); margin: 0 auto; padding: 0 var(--page-gutter) 0.9rem; font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.1em; color: var(--color-muted); }

  .empty { max-width: var(--shell); margin: 0 auto; padding: 3rem var(--page-gutter); color: var(--color-muted); }
  .empty p { margin: 0 0 0.75rem; line-height: 1.6; }
  .empty code { font-family: var(--font-label); background: var(--color-paper-2); border: 1px solid var(--color-paper-3); padding: 0.15em 0.5em; }

  .foot { background: var(--color-ink); color: var(--color-accent-ink); padding: 1.5rem var(--page-gutter) 2.5rem; }
  .foot-inner { max-width: var(--shell); margin: 0 auto; font-size: 0.8rem; line-height: 1.7; opacity: 0.85; }
</style>
</head>
<body>

<div class="halftone" aria-hidden="true"></div>

<header class="masthead">
  <div class="masthead-inner">
    <p class="eyebrow">DELTA AI TREND DAILY</p>
    <h1>{{ newsletter_name }}</h1>
    <p>每天更新，用一杯咖啡的時間，帶你發掘最值得一看的 AI 動態。</p>
  </div>
</header>

<div class="ornament-row" aria-hidden="true">✱ ✱ ✱ ✱</div>

{% if modules_by_group %}
{# 依領域瀏覽入口（2026-08-26 主管反饋：特定領域的讀者用月曆不好查）。 #}
<nav class="module-entry" aria-label="依領域瀏覽">
  <p class="module-entry-label">只追特定領域？點領域看跨期彙整</p>
  <div class="module-entry-row">
    {% for m in modules_by_group.domain %}<a class="module-entry-chip domain" href="/modules/{{ m.id }}">{{ m.name }}</a>{% endfor %}
    {% for m in modules_by_group.functional %}<a class="module-entry-chip" href="/modules/{{ m.id }}">{{ m.name }}</a>{% endfor %}
  </div>
</nav>
{% endif %}

{% if months %}
<section class="cal-wrap" aria-label="出刊日曆">
  {% for month in months %}
  <div class="cal-month">
    <h2 class="cal-title">{{ month.label }}</h2>
    <div class="cal-board">
      <div class="cal-head">
        <span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span>
      </div>
      {% for week in month.weeks %}
      <div class="cal-week">
        {% for cell in week %}
        <div class="cal-cell{% if not cell.in_month %} out{% endif %}{% if cell.is_today %} today{% endif %}">
          <span class="cal-day">{{ cell.day }}</span>
          {% for issue in cell.issues %}
          <a class="cal-chip{% if issue.cadence == 'weekly' %} weekly{% endif %}" href="/issues/{{ issue.id }}">
            {%- if issue.cadence == 'weekly' -%}{{ issue.headline or '週報' }}
            {%- else -%}{{ issue.count }} 則{%- endif -%}
          </a>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
    <div class="cal-legend">
      <span><span class="cal-chip">N 則</span> 日報（點進去看當天）</span>
      <span><span class="cal-chip weekly">週報</span> 每週一出，涵蓋上週日到週六</span>
    </div>
  </div>
  {% endfor %}
</section>
{% endif %}

{% if issues %}
<p class="list-heading">全部期數</p>
<nav class="issue-index" aria-label="期數列表">
  {% for issue in issues %}
  <a class="issue-card" href="/issues/{{ issue.id }}">
    <div class="issue-card-row">
      <span class="issue-card-title">第 {{ issue.no if issue.no is defined else issue.id }} 期</span>
      {# 週報跟日報混在同一個列表，不標出來分不出誰是誰。舊的 7 期 cadence
         是 NULL（日報化之前的週報時代），不標。#}
      {% if issue.cadence == 'weekly' %}
      <span class="issue-card-cadence weekly">週報{% if issue.period_start %} {{ issue.period_start }} ~ {{ issue.period_end }}{% endif %}</span>
      {% elif issue.cadence == 'daily' %}
      <span class="issue-card-cadence">日報</span>
      {% endif %}
      <span class="issue-card-date">{{ issue.issue_date }}</span>
    </div>
  </a>
  {% endfor %}
</nav>
{% else %}
<div class="empty">
  <p>目前還沒有任何一期。</p>
  <p>跑 <code>python -m scripts.compose_topic_issue</code> 組一期看看。</p>
</div>
{% endif %}

<footer class="foot">
  <div class="foot-inner"><p>{{ newsletter_name }}．僅供台達內部參考。</p></div>
</footer>

</body>
</html>
