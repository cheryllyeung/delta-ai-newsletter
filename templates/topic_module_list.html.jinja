<!--
依領域瀏覽頁：單一模組的所有出刊文章時間軸（scripts/serve_topics.py 的
/modules/{module_id}）。跟 topic_issue_list.html.jinja 共用同一套 Carnival
藍設計語彙。2026-08-26 加，回應主管「特定領域的讀者用月曆不好查」的反饋。
-->
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ module.name }}｜{{ newsletter_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800&family=Noto+Sans+TC:wght@700;900&family=IBM+Plex+Sans:wght@400;500&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root {
    --color-paper:   oklch(93% 0.020 240);
    --color-paper-2: oklch(89% 0.024 238);
    --color-paper-3: oklch(83% 0.028 235);
    --color-ink:     oklch(16% 0.030 250);
    --color-ink-2:   oklch(28% 0.028 248);
    --color-muted:   oklch(46% 0.020 245);
    --color-accent:      oklch(58% 0.160 247);
    --color-accent-ink:  oklch(97% 0.010 240);
    --color-accent-2:    oklch(76% 0.150  75);
    --font-display: "Big Shoulders Display", "Noto Sans TC", sans-serif;
    --font-body:    "IBM Plex Sans", ui-sans-serif, "PingFang TC", "Noto Sans TC", sans-serif;
    --font-label:   "JetBrains Mono", ui-monospace, monospace;
    --page-gutter: clamp(1.25rem, 4vw, 3rem);
    --shell: 46rem;
  }
  * { box-sizing: border-box; }
  html, body { overflow-x: clip; margin: 0; padding: 0; }
  body { background: var(--color-paper); color: var(--color-ink); font-family: var(--font-body); }
  a { color: inherit; text-decoration: none; }
  h1 { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; line-height: 0.96; }

  .masthead { background: var(--color-accent); color: var(--color-accent-ink); padding: 2.5rem var(--page-gutter) 2rem; }
  .masthead-inner { max-width: var(--shell); margin: 0 auto; }
  .back-link { font-family: var(--font-label); font-size: 0.78rem; display: inline-block; margin-bottom: 0.8rem; opacity: 0.85; }
  .back-link:hover { opacity: 1; text-decoration: underline; }
  .masthead .eyebrow { font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.1em; margin: 0 0 0.5rem; }
  .masthead h1 { margin: 0; font-size: clamp(1.8rem, 3.4vw + 1rem, 2.8rem); }
  .masthead p { margin: 0.8rem 0 0; font-size: 0.88rem; line-height: 1.6; max-width: 56ch; color: color-mix(in oklch, var(--color-accent-ink) 85%, transparent); }

  .module-nav { max-width: var(--shell); margin: 0 auto; padding: 1.2rem var(--page-gutter) 0.4rem; }
  .module-nav-label { font-family: var(--font-label); font-size: 0.72rem; color: var(--color-muted); margin: 0 0 0.4rem; }
  .module-nav-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.7rem; }
  .module-chip { font-family: var(--font-label); font-size: 0.72rem; border: 1.5px solid var(--color-ink); background: var(--color-paper-2); padding: 0.25em 0.6em; }
  .module-chip:hover { background: var(--color-accent); color: var(--color-accent-ink); }
  .module-chip.active { background: var(--color-ink); color: var(--color-paper); }

  /* 兩欄格線：日期小標橫跨整列，同一天的文章在小標下面並排，多的往下折。 */
  .timeline { max-width: var(--shell); margin: 0 auto; padding: 1rem var(--page-gutter) 4rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; }
  @media (max-width: 40rem) { .timeline { grid-template-columns: 1fr; } }
  .timeline-date { grid-column: 1 / -1; font-family: var(--font-label); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; color: var(--color-accent); margin: 1rem 0 -0.2rem; display: flex; align-items: center; gap: 0.7em; }
  .timeline-date::after { content: ""; flex: 1; border-top: 2px solid var(--color-paper-3); }
  .timeline-date:first-child { margin-top: 0.2rem; }
  .entry { display: block; background: var(--color-paper-2); border: 2px solid var(--color-ink); box-shadow: 3px 3px 0 var(--color-ink); padding: 1rem 1.2rem; transition: transform 120ms ease-out, box-shadow 120ms ease-out; }
  .entry:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--color-ink); }
  .entry h2 { margin: 0 0 0.25rem; font-size: 1.05rem; line-height: 1.4; }
  .entry .subhead { margin: 0; font-size: 0.85rem; line-height: 1.55; color: var(--color-ink-2); }

  .empty { max-width: var(--shell); margin: 0 auto; padding: 3rem var(--page-gutter); color: var(--color-muted); }
  .foot { background: var(--color-ink); color: var(--color-accent-ink); padding: 1.5rem var(--page-gutter) 2.5rem; }
  .foot-inner { max-width: var(--shell); margin: 0 auto; font-size: 0.8rem; opacity: 0.85; }
</style>
</head>
<body>

<header class="masthead">
  <div class="masthead-inner">
    <a class="back-link" href="/">← 回首頁</a>
    <p class="eyebrow">依領域瀏覽</p>
    {# 這裡刻意不放 module.desc：那段是寫給打分 prompt 的模組定義
       （「台達的○○人員。AI 在…的應用」這種第三人稱內部說明），
       不是給讀者看的文案（2026-08-28 使用者反饋）。 #}
    <h1>{{ module.name }}</h1>
  </div>
</header>

<nav class="module-nav" aria-label="領域切換">
  <p class="module-nav-label">事業領域</p>
  <div class="module-nav-row">
    {% for m in modules_by_group.domain %}
    <a class="module-chip{% if m.id == module.id %} active{% endif %}" href="/modules/{{ m.id }}">{{ m.name }}</a>
    {% endfor %}
  </div>
  <p class="module-nav-label">工作職能</p>
  <div class="module-nav-row">
    {% for m in modules_by_group.functional %}
    <a class="module-chip{% if m.id == module.id %} active{% endif %}" href="/modules/{{ m.id }}">{{ m.name }}</a>
    {% endfor %}
  </div>
</nav>

{% if entries %}
<section class="timeline" aria-label="文章時間軸">
  {% for e in entries %}
  {# entries 從 serve_topics 來就是日期新到舊，換日時插一條日期小標，
     同一天的文章掛在同一條下面。相關度分數是選題內部指標，不給讀者看
     （2026-08-28 使用者反饋，跟 module.desc 同一批拿掉）。 #}
  {% if loop.changed(e.issue_date) %}
  <p class="timeline-date">{{ e.issue_date[5:7] | int }}/{{ e.issue_date[8:10] | int }}</p>
  {% endif %}
  <div class="entry">
    <a href="/issues/{{ e.issue_id }}/topics/{{ e.generated_id }}">
      <h2>{{ e.headline }}</h2>
      {% if e.subhead %}<p class="subhead">{{ e.subhead }}</p>{% endif %}
    </a>
  </div>
  {% endfor %}
</section>
{% else %}
<div class="empty"><p>這個領域目前還沒有夠相關的出刊文章。</p></div>
{% endif %}

<footer class="foot">
  <div class="foot-inner"><p>{{ newsletter_name }}．僅供台達內部參考。</p></div>
</footer>

</body>
</html>
