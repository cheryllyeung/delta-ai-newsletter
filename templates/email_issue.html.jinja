{#
EDM 雜誌版模板（tools/render_issue_email.py 渲染）。純 table + 行內樣式,
Outlook 用 Word 引擎渲染信件,現代 CSS 不吃。設計語言（米白紙底、Noto
Sans、金色點綴、大號裝飾序號）跟網頁的摘要頁/全文頁一致,三處看起來
是同一份刊物。字體用 Noto Sans TC(載不進來退回微軟正黑,不掉質感)。
#}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
<title>{{ issue_title }}</title>
</head>
{% set SANS = "'Noto Sans TC', 'Microsoft JhengHei', 'PingFang TC', Arial, sans-serif" %}
<body style="margin:0; padding:28px 12px; background-color:#e8e4da;">
<table role="presentation" width="660" cellpadding="0" cellspacing="0" border="0" align="center"
       style="width:660px; max-width:100%; background:#fbfaf6; box-shadow:0 6px 24px rgba(40,36,28,0.14);">

  <!-- 刊頭 -->
  <tr><td style="padding:40px 44px 24px; border-bottom:2px solid #1a1a1a;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td valign="bottom">
        <div style="font-family:{{ SANS }}; font-size:11px; letter-spacing:4px; color:#8a5a1a; font-weight:700;">DELTA · NBDMD</div>
        <div style="font-family:{{ SANS }}; font-size:32px; font-weight:900; color:#1a1a1a; margin-top:6px; line-height:1.1;">{{ newsletter_name }}</div>
      </td>
      <td valign="bottom" align="right">
        <div style="font-family:{{ SANS }}; font-size:13px; color:#8a8578;">{{ issue_date }}</div>
        <div style="font-family:{{ SANS }}; font-size:13px; color:#8a8578;">第 {{ issue_no }} 期 · 共 {{ articles | length }} 則</div>
      </td>
    </tr></table>
  </td></tr>

  <!-- 報頭導語（2026-09-18 刊物改版） -->
  {% if tldr and tldr.get('headline') %}
  <tr><td style="padding:18px 44px 0;">
    <div style="font-family:{{ SANS }}; font-size:15px; font-weight:500; color:#1a1a1a; line-height:1.6;">{{ tldr.headline }}</div>
  </td></tr>
  {% endif %}

  <!-- 本期導讀（TLDR）。2026-09-21 改版：按面向（市場/技術/臨床/法規）
       分大區塊，不再分趨勢/重點/觀察（主管反映三類界線模糊）。分組在
       render_issue_email.py 端做，舊期數退回原三類標籤。 -->
  {% if tldr_groups %}
  <tr><td style="padding:24px 44px 0;">
    <div style="font-family:{{ SANS }}; font-size:12px; letter-spacing:4px; color:#8a8578;">本期導讀</div>
    <div style="font-family:{{ SANS }}; font-size:11px; color:#8a8578; margin-top:6px;">編號對應下方報導</div>
    {% for group in tldr_groups %}
    <div style="font-family:{{ SANS }}; font-size:11px; letter-spacing:2px; font-weight:700; color:#c9a54a; margin-top:16px;">{{ group.label }}</div>
    {% for text in group.entries %}
    <div style="font-family:{{ SANS }}; font-size:13px; line-height:1.8; color:#44474a; margin-top:5px; padding-left:14px; text-indent:-14px;">— {{ text }}</div>
    {% endfor %}
    {% endfor %}
  </td></tr>
  <tr><td style="padding:28px 44px 4px;"><div style="border-top:2px solid #1a1a1a; height:1px; line-height:1px;">&nbsp;</div></td></tr>
  {% endif %}

  <!-- 報導清單（2026-09-30 改版）。
       改版重點：信裡不再放全文。EDM 的定位改成「選出今天值得看的幾則，
       並給出主編觀點」，內容讓讀者點原文去看。每則多了標籤（廠商／產品／
       技術，經原文比對才顯示，見 pipeline/edm_tags.py），並分成主要報導
       （NBDMD 清單來源或主角是 26 家 watchlist 廠商）與額外報導兩區。 -->
  {% macro item_block(a, loop_index, full) %}
  <tr><td style="padding:0 44px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td width="46" valign="top" style="width:46px;">
        <div style="font-family:{{ SANS }}; font-size:30px; font-weight:900; color:#e4dccb; line-height:1;">{{ "%02d"|format(loop_index) }}</div>
      </td>
      <td valign="top" style="padding-left:8px;">
        {% if a.tags %}
        {# 標籤用 #hashtag 純文字（2026-09-30 使用者選的寫法）。先前用框線
           的版本在 Outlook 裡壞掉：Outlook 以 Word 引擎渲染，會丟掉 span 的
           margin 與 padding，標籤黏成「CDK4MCL1CD276」一串。純文字不依賴
           盒模型，中間用不斷行空白撐開，任何客戶端都不會黏。 #}
        <div style="font-family:{{ SANS }}; font-size:11px; color:#8a5a1a; line-height:1.8; margin-bottom:6px;">{% for t in a.tags %}#{{ t }}{% if not loop.last %}&nbsp;&nbsp;&nbsp;{% endif %}{% endfor %}</div>
        {% endif %}
        {# 類別標示不上色（2026-09-30）：原本每個類別一個色碼，法規與給付
           是紫色、臨床應用是酒紅，沒有說明的情況下讀者只會問「紫色是什麼
           意思」。類別名稱本身已經寫清楚了，顏色反而是雜訊。 #}
        {# 標上發布日期與預印本（2026-09-30 主管實查要求）：新鮮度與證據
           等級是讀者判斷要不要往下追的前提，原本版面上看不出來。 #}
        <div style="font-family:{{ SANS }}; font-size:11px; letter-spacing:2px; font-weight:700; color:#8a8578;">{{ a.primary_tag }}{% if a.is_taiwan %} · 台灣{% endif %}{% if a.published_date %} · {{ a.published_date }}{% endif %}{% if a.source_count > 1 %} · {{ a.source_count }} 家在報{% endif %}{% if a.is_preprint %} · <span style="color:#8a5a1a;">預印本，未經同儕審查</span>{% endif %}</div>
        <div style="margin-top:6px;">
          {# 顏色寫在連結裡面的 span，不只寫在 <a> 上：Outlook 會把點過的
             連結套上 Word 的「已瀏覽超連結」樣式，蓋掉 <a> 自己的 color，
             標題就變紫色（2026-09-30 使用者問「有些紫色是什麼意思」）。
             子元素的 color 不會被蓋，所以兩邊都寫。 #}
          <a href="{{ a.source_url or a.url }}" style="font-family:{{ SANS }}; font-size:{{ '20px' if full else '17px' }}; font-weight:700; line-height:1.45; color:#1a1a1a; text-decoration:none;"><span style="color:#1a1a1a; text-decoration:none;">{{ a.headline }}</span></a>
        </div>
        {% if full and a.subhead %}<div style="font-family:{{ SANS }}; font-size:13px; line-height:1.7; color:#8a5a1a; margin-top:6px;">{{ a.subhead }}</div>{% endif %}
        {% if a.summary %}<div style="font-family:{{ SANS }}; font-size:14px; line-height:1.85; color:#44474a; margin-top:8px;">{{ a.summary }}</div>{% endif %}
        {% if full and a.stats %}
        <div style="margin-top:10px;">
          {% for stat in a.stats %}
          <span style="font-family:{{ SANS }}; font-size:12px; color:#8a5a1a; margin-right:16px;"><b style="font-size:15px;">{{ stat.value }}</b> {{ stat.label }}</span>
          {% endfor %}
        </div>
        {% endif %}
        {% if full and a.delta_insight %}
        <div style="border-left:3px solid #c9a54a; padding:8px 14px; margin-top:12px; background:#f6f2e8;">
          <div style="font-family:{{ SANS }}; font-size:12px; font-weight:700; color:#8a5a1a;">對行動基因的意義</div>
          {% for para in a.delta_insight.paragraphs %}
          <div style="font-family:{{ SANS }}; font-size:13px; line-height:1.8; color:#44474a; margin-top:5px;">{{ para }}</div>
          {% endfor %}
        </div>
        {% endif %}
        <div style="margin-top:10px;">
          {% if a.source_url %}
          <a href="{{ a.source_url }}" target="_blank" style="font-family:{{ SANS }}; font-size:12px; letter-spacing:1px; color:#1a1a1a; text-decoration:none; border-bottom:1px solid #c9a54a; padding-bottom:2px;"><span style="color:#1a1a1a; text-decoration:none;">{{ a.source_name }}｜看原文 →</span></a>
          {% endif %}
        </div>
      </td>
    </tr></table>
  </td></tr>
  <tr><td style="padding:20px 44px;"><div style="border-top:1px solid #ece7dc; height:1px; line-height:1px;">&nbsp;</div></td></tr>
  {% endmacro %}

  {% if primary_articles %}
  <tr><td style="padding:8px 44px 0;">
    <div style="font-family:{{ SANS }}; font-size:13px; letter-spacing:4px; color:#1a1a1a; font-weight:700; border-bottom:2px solid #1a1a1a; padding-bottom:6px;">主要報導</div>
    <div style="font-family:{{ SANS }}; font-size:11px; color:#8a8578; margin-top:6px;">重點關注廠商與指定來源{% if watchlist_hits == 0 %}（今日未收錄到名單廠商的動態）{% endif %}</div>
  </td></tr>
  <tr><td style="height:14px; line-height:14px;">&nbsp;</td></tr>
  {% for a in primary_articles %}{{ item_block(a, a.display_num or loop.index, true) }}{% endfor %}
  {% endif %}

  {% if extra_articles %}
  <tr><td style="padding:8px 44px 0;">
    <div style="font-family:{{ SANS }}; font-size:13px; letter-spacing:4px; color:#1a1a1a; font-weight:700; border-bottom:2px solid #1a1a1a; padding-bottom:6px;">額外報導</div>
    <div style="font-family:{{ SANS }}; font-size:11px; color:#8a8578; margin-top:6px;">其他來源的相關動態</div>
  </td></tr>
  <tr><td style="height:14px; line-height:14px;">&nbsp;</td></tr>
  {% for a in extra_articles %}{{ item_block(a, a.display_num or (loop.index + (primary_articles | length)), false) }}{% endfor %}
  {% endif %}

  {# 研究預印本（2026-09-30 加）：與廠商動態分開排，讀者才看得出證據
     等級。選題端另有每期上限（config 的 tier_cap.preprint）。 #}
  {% if preprint_articles %}
  <tr><td style="padding:8px 44px 0;">
    <div style="font-family:{{ SANS }}; font-size:13px; letter-spacing:4px; color:#1a1a1a; font-weight:700; border-bottom:2px solid #1a1a1a; padding-bottom:6px;">研究預印本</div>
    <div style="font-family:{{ SANS }}; font-size:11px; color:#8a8578; margin-top:6px;">尚未經同儕審查，供技術方向參考</div>
  </td></tr>
  <tr><td style="height:14px; line-height:14px;">&nbsp;</td></tr>
  {% for a in preprint_articles %}{{ item_block(a, a.display_num or loop.index, false) }}{% endfor %}
  {% endif %}

  <!-- 主編觀察（2026-09-30 改版）：四位分析師分面向，2x2 橫排。
       Outlook 用 Word 引擎渲染，不執行 JavaScript、也幾乎不吃媒體查詢，
       所以橫排只能用表格；窄視窗的客戶端會自動把兩欄堆疊起來。
       舊期數沒有 editorial_sections，退回顯示原本的段落式主編觀察。 -->
  {% if editorial_sections %}
  <tr><td style="padding:8px 44px 0;">
    <div style="font-family:{{ SANS }}; font-size:13px; letter-spacing:4px; color:#1a1a1a; font-weight:700; border-bottom:2px solid #1a1a1a; padding-bottom:6px;">主編觀察</div>
    <div style="font-family:{{ SANS }}; font-size:11px; color:#8a8578; margin-top:6px;">從市場、技術、法規、臨床四大面向追蹤</div>
  </td></tr>
  <tr><td style="padding:16px 44px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      {% for row in editorial_sections | batch(2) %}
      <tr>
        {% for sec in row %}
        <td width="50%" valign="top" style="width:50%; padding:0 10px 18px 0;">
          <div style="background:#f6f2e8; border-left:3px solid #c9a54a; padding:12px 14px;">
            <div style="font-family:{{ SANS }}; font-size:11px; font-weight:700; letter-spacing:2px; color:#8a5a1a;">{{ sec.dimension }}觀察</div>
            {% if sec.lead %}
            <div style="font-family:{{ SANS }}; font-size:15px; font-weight:700; line-height:1.55; color:#1a1a1a; margin-top:8px;">{{ sec.lead }}</div>
            {% endif %}
            <div style="font-family:{{ SANS }}; font-size:13px; line-height:1.85; color:#44474a; margin-top:8px;">{{ sec.body_html or sec.text }}</div>
            {% if sec.question %}
            <div style="font-family:{{ SANS }}; font-size:12px; line-height:1.7; color:#8a5a1a; margin-top:10px; padding-top:8px; border-top:1px dashed #d8c9a8;">{{ sec.question }}</div>
            {% endif %}
          </div>
        </td>
        {% endfor %}
        {% if row | length == 1 %}<td width="50%" style="width:50%;">&nbsp;</td>{% endif %}
      </tr>
      {% endfor %}
    </table>
    {# 這裡原本還有一行「本欄由 AI 依本期報導綜合而成」，2026-09-30 拿掉：
       信尾已經講過同一件事，重複一次只是佔位。 #}
  </td></tr>
  <tr><td style="padding:24px 44px;"><div style="border-top:1px solid #ece7dc; height:1px; line-height:1px;">&nbsp;</div></td></tr>
  {% elif tldr and tldr.get('editorial') %}
  <tr><td style="padding:0 44px;">
    <div style="font-family:{{ SANS }}; font-size:12px; letter-spacing:4px; color:#8a8578;">主編觀察</div>
    {% for para in tldr.editorial %}
    <div style="font-family:{{ SANS }}; font-size:14px; line-height:1.9; color:#44474a; margin-top:12px;">{{ para }}</div>
    {% endfor %}
    <div style="font-family:{{ SANS }}; font-size:12px; line-height:1.8; color:#8a8578; margin-top:14px;">本欄由 AI 依本期報導綜合而成，屬推測性觀點，請以各篇原文為準。</div>
  </td></tr>
  <tr><td style="padding:28px 44px;"><div style="border-top:1px solid #ece7dc; height:1px; line-height:1px;">&nbsp;</div></td></tr>
  {% endif %}

  <!-- 信底常見問題（2026-09-30 加）。編輯邏輯的說明試過兩版：一整框的
       自我說明像把內部文件夾進刊物，另附 PDF 沒人會為了日報去開附件。
       改成問答放信底，有疑問往下看就有答案，沒疑問的人不受干擾。
       問題裡的數字由 tools/render_issue_email.py 現算。 -->
  {% if faq %}
  <tr><td style="padding:0 44px 8px;">
    <div style="font-family:{{ SANS }}; font-size:12px; letter-spacing:4px; color:#8a8578;">關於這份日報</div>
  </td></tr>
  {% for item in faq %}
  <tr><td style="padding:14px 44px 0;">
    <div style="font-family:{{ SANS }}; font-size:13px; font-weight:700; color:#8a5a1a; line-height:1.6;">Q{{ loop.index }}　{{ item.q }}</div>
    {# 答案結構固定成「先講標準、再列點、最後收一句」（2026-09-30 使用者
       指定的寫法）。列點用 div 不用 ol：Outlook 對清單的縮排處理不穩，
       序號自己印比較可控。 #}
    {% if item.lead %}<div style="font-family:{{ SANS }}; font-size:13px; line-height:1.85; color:#44474a; margin-top:5px;">{{ item.lead }}</div>{% endif %}
    {% for point in item.points or [] %}
    <div style="font-family:{{ SANS }}; font-size:13px; line-height:1.8; color:#44474a; margin-top:3px; padding-left:20px; text-indent:-20px;">{{ loop.index }}.　{{ point }}</div>
    {% endfor %}
    {% if item.tail %}<div style="font-family:{{ SANS }}; font-size:13px; line-height:1.85; color:#44474a; margin-top:5px;">{{ item.tail }}</div>{% endif %}
    {% if item.a %}<div style="font-family:{{ SANS }}; font-size:13px; line-height:1.85; color:#44474a; margin-top:4px;">{{ item.a }}</div>{% endif %}
  </td></tr>
  {% endfor %}
  <tr><td style="padding:24px 44px 0;"><div style="border-top:1px solid #ece7dc; height:1px; line-height:1px;">&nbsp;</div></td></tr>
  {% endif %}

  <!-- 信尾 -->
  <tr><td style="padding:0 44px 36px;">
    {# 2026-09-21 拿掉網站網址與來源清單連結：主管指示信裡不放內部
       伺服器位址，網頁版自己內部用就好。 #}
    <div style="font-family:{{ SANS }}; font-size:12px; line-height:1.9; color:#8a8578;">
      摘要與導讀由 AI 生成並經自動自檢，每則均附原文出處，請以原文為準。
      僅供台達內部參考，請勿外流。
    </div>
  </td></tr>

</table>
</body>
</html>
