<!--
模型與工具發佈頁（scripts/serve_topics.py 的 /releases）。跟
topic_module_list.html.jinja 共用同一套 Carnival 藍設計語彙，差別在：
列的是池裡的文章不是出刊文章（標題直接連原文、開新分頁），上方多一個
排行榜區塊。2026-08-28 加。
-->
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>模型與工具發佈｜{{ newsletter_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800&family=Noto+Sans+TC:wght@700;900&family=IBM+Plex+Sans:wght@400;500&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root {
    --color-paper:   #eef1f4;
    --color-paper-2: #ffffff;
    --color-paper-3: #dde4ea;
    --color-ink:     #1c2b38;
    --color-ink-2:   #33424f;
    --color-muted:   #5a6672;
    --color-accent:      #1f4e8c;
    --color-accent-ink:  #ffffff;
    --color-accent-2:    #c07a2a;
    --font-display: "Noto Sans TC", "Microsoft JhengHei", sans-serif;
    --font-body:    "IBM Plex Sans", ui-sans-serif, "PingFang TC", "Noto Sans TC", sans-serif;
    --font-label:   "JetBrains Mono", ui-monospace, monospace;
    --page-gutter: clamp(1.25rem, 4vw, 3rem);
    --shell: 46rem;
  }
  * { box-sizing: border-box; }
  html, body { overflow-x: clip; margin: 0; padding: 0; }
  body { background: var(--color-paper); color: var(--color-ink); font-family: var(--font-body); }
  a { color: inherit; text-decoration: none; }
  h1 { font-family: var(--font-display); font-weight: 800;  line-height: 0.96; }

  .masthead { background: var(--color-accent); color: var(--color-accent-ink); padding: 2.5rem var(--page-gutter) 2rem; }
  .masthead-inner { max-width: var(--shell); margin: 0 auto; }
  .back-link { font-family: var(--font-label); font-size: 0.78rem; display: inline-block; margin-bottom: 0.8rem; opacity: 0.85; }
  .back-link:hover { opacity: 1; text-decoration: underline; }
  .masthead .eyebrow { font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.1em; margin: 0 0 0.5rem; }
  .masthead h1 { margin: 0; font-size: clamp(1.8rem, 3.4vw + 1rem, 2.8rem); }
  .masthead p { margin: 0.8rem 0 0; font-size: 0.88rem; line-height: 1.6; max-width: 56ch; color: color-mix(in oklch, var(--color-accent-ink) 85%, transparent); }

  /* 排行榜入口 chip：跟篩選 chip 同型但走強調色，表明是連結不是篩選。 */
  .lb-chip { border-color: var(--color-accent); color: var(--color-accent); font-weight: 700; }

  .vendor-nav { max-width: var(--shell); margin: 0 auto; padding: 1.2rem var(--page-gutter) 0.4rem; }
  .vendor-nav-label { font-family: var(--font-label); font-size: 0.72rem; color: var(--color-muted); margin: 0 0 0.4rem; }
  .vendor-nav-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.7rem; }
  .vendor-chip { font-family: var(--font-label); font-size: 0.72rem; border: 1px solid #c9d2da; background: var(--color-paper-2); padding: 0.25em 0.6em; }
  .vendor-chip:hover { background: var(--color-accent); color: var(--color-accent-ink); }
  .vendor-chip.active { background: var(--color-ink); color: var(--color-paper); }

  /* 跟 topic_module_list.html.jinja 同一套：兩欄格線，日期小標橫跨整列，
     同一天的發佈並排、多的往下折。 */
  .timeline { max-width: var(--shell); margin: 0 auto; padding: 1rem var(--page-gutter) 4rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; }
  @media (max-width: 40rem) { .timeline { grid-template-columns: 1fr; } }
  .timeline-date { grid-column: 1 / -1; font-family: var(--font-label); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; color: var(--color-accent); margin: 1rem 0 -0.2rem; display: flex; align-items: center; gap: 0.7em; }
  .timeline-date::after { content: ""; flex: 1; border-top: 2px solid var(--color-paper-3); }
  .timeline-date:first-child { margin-top: 0.2rem; }
  .entry { display: block; background: var(--color-paper-2); border: 1px solid #d8dee4; box-shadow: 0 1px 4px rgba(28,43,56,0.10); padding: 1rem 1.2rem; transition: transform 120ms ease-out, box-shadow 120ms ease-out; }
  .entry:hover { transform: translate(-1px, -1px); box-shadow: 0 2px 8px rgba(28,43,56,0.14); }
  .entry-meta { font-family: var(--font-label); font-size: 0.72rem; color: var(--color-muted); margin-bottom: 0.35rem; display: flex; gap: 0.9em; flex-wrap: wrap; align-items: baseline; }
  .vendor-badge { border: 1.5px solid var(--color-accent); color: var(--color-accent); padding: 0.1em 0.5em; font-weight: 700; }
  .kind-badge { border: 1px solid #c9d2da; background: var(--color-paper); padding: 0.1em 0.5em; }
  .entry h2 { margin: 0 0 0.25rem; font-size: 1.05rem; line-height: 1.4; }
  .entry .subhead { margin: 0; font-size: 0.85rem; line-height: 1.55; color: var(--color-ink-2); }
  .entry .source-note { margin: 0.4rem 0 0; font-family: var(--font-label); font-size: 0.68rem; color: var(--color-muted); }

  .empty { max-width: var(--shell); margin: 0 auto; padding: 3rem var(--page-gutter); color: var(--color-muted); }
  .foot { background: var(--color-ink); color: var(--color-accent-ink); padding: 1.5rem var(--page-gutter) 2.5rem; }
  .foot-inner { max-width: var(--shell); margin: 0 auto; font-size: 0.8rem; opacity: 0.85; }
</style>
</head>
<body>

<header class="masthead">
  <div class="masthead-inner">
    <a class="back-link" href="/">← 回首頁</a>
    <p class="eyebrow">特輯</p>
    <h1>模型與工具發佈</h1>
  </div>
</header>

<nav class="vendor-nav" aria-label="篩選">
  {# 兩排篩選可疊加：chip 的連結會保留另一排目前選中的值。 #}
  <p class="vendor-nav-label">依廠商看</p>
  <div class="vendor-nav-row">
    <a class="vendor-chip{% if not active_vendor %} active{% endif %}" href="/releases{% if active_kind %}?kind={{ active_kind }}{% endif %}">全部</a>
    {% for v in vendors %}
    <a class="vendor-chip{% if v.name == active_vendor %} active{% endif %}" href="/releases?vendor={{ v.name | urlencode }}{% if active_kind %}&amp;kind={{ active_kind }}{% endif %}">{{ v.name }}（{{ v.count }}）</a>
    {% endfor %}
  </div>
  <p class="vendor-nav-label">依類型看</p>
  <div class="vendor-nav-row">
    <a class="vendor-chip{% if not active_kind %} active{% endif %}" href="/releases{% if active_vendor %}?vendor={{ active_vendor | urlencode }}{% endif %}">全部</a>
    {% for k in kinds %}
    <a class="vendor-chip{% if k.id == active_kind %} active{% endif %}" href="/releases?kind={{ k.id }}{% if active_vendor %}&amp;vendor={{ active_vendor | urlencode }}{% endif %}">{{ k.name }}（{{ k.count }}）</a>
    {% endfor %}
    {# 排行榜入口：類型排最後一顆 chip，點進 /leaderboard 看完整榜
       （2026-08-28 使用者定調，不做成獨立卡片也不放整組榜在頁面上）。 #}
    <a class="vendor-chip lb-chip" href="/leaderboard">模型排行榜 →</a>
  </div>
</nav>

{% if entries %}
<section class="timeline" aria-label="發佈時間軸">
  {% for e in entries %}
  {% if loop.changed(e.published_date) %}
  <p class="timeline-date">{{ e.published_date[5:7] | int }}/{{ e.published_date[8:10] | int }}</p>
  {% endif %}
  <div class="entry">
    <a href="{{ e.url }}" target="_blank" rel="noopener">
      <div class="entry-meta">
        {% if e.release_vendor %}<span class="vendor-badge">{{ e.release_vendor }}</span>{% endif %}
        {% if e.kind_name %}<span class="kind-badge">{{ e.kind_name }}</span>{% endif %}
      </div>
      <h2>{% if e.release_product %}{{ e.release_product }}：{% endif %}{{ e.title }}</h2>
      {% if e.one_line_summary %}<p class="subhead">{{ e.one_line_summary }}</p>{% endif %}
      <p class="source-note">{{ e.source_name }}｜點開看原文 ↗</p>
    </a>
  </div>
  {% endfor %}
</section>
{% else %}
{# 空狀態只給讀者看的一句話，維運指令（backfill_release_check）不放頁面上
   （2026-08-28 使用者要求，跟排行榜空狀態同一批改掉）。 #}
{% if active_vendor or active_kind %}
<div class="empty"><p>這個組合目前沒有發佈，換個篩選看看。</p></div>
{% else %}
<div class="empty"><p>最新發佈整理中，敬請期待。</p></div>
{% endif %}
{% endif %}

<footer class="foot">
  <div class="foot-inner"><p>{{ newsletter_name }}．僅供台達內部參考。</p></div>
</footer>

</body>
</html>
