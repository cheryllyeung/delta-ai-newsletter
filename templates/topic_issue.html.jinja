<!--
本期摘要頁（genomics-prototype，2026-09-03 改雜誌版型）。跟 EDM 信件、
全文頁同一套視覺（米白紙底、Noto Sans、金色點綴、裝飾序號）。
動線：EDM 信件（摘要）→ 閱讀全文 → 全文頁 → 可退回本頁。三處看起來
是同一份刊物。
-->
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
<title>{{ issue_title }}</title>
<style>
  * { box-sizing: border-box; }
  body { margin: 0; padding: 28px 12px; background-color: #e8e4da;
         font-family: "Noto Sans TC", "Microsoft JhengHei", "PingFang TC", Arial, sans-serif; }
  .card { max-width: 660px; margin: 0 auto; background: #fbfaf6; box-shadow: 0 6px 24px rgba(40,36,28,0.14); }

  .head { padding: 28px 44px 24px; border-bottom: 2px solid #1a1a1a; }
  .head-nav { margin: 0 0 18px; font-size: 12px; }
  .head-nav a { color: #8a5a1a; text-decoration: none; margin-right: 16px; }
  .head-nav a:hover { text-decoration: underline; }
  .head-row { display: flex; justify-content: space-between; align-items: flex-end; }
  .head .eyebrow { font-size: 11px; letter-spacing: 4px; color: #8a5a1a; font-weight: 700; }
  .head .brand { font-size: 32px; font-weight: 900; color: #1a1a1a; margin: 6px 0 0; line-height: 1.1; }
  .head .meta { font-size: 13px; color: #8a8578; text-align: right; }

  .tldr { padding: 24px 44px 0; }
  .tldr-title { font-size: 12px; letter-spacing: 4px; color: #8a8578; margin: 0; }
  .tldr-group { font-size: 11px; letter-spacing: 2px; font-weight: 700; color: #c9a54a; margin: 16px 0 0; }
  .tldr-item { font-size: 13px; line-height: 1.8; color: #44474a; margin-top: 5px; padding-left: 14px; text-indent: -14px; }
  .rule { border-top: 2px solid #1a1a1a; margin: 28px 44px 4px; height: 1px; }

  .item { padding: 0 44px; }
  .item-inner { display: flex; }
  .num { width: 52px; flex-shrink: 0; font-size: 34px; font-weight: 900; color: #e4dccb; line-height: 1; }
  .item-body { padding-left: 8px; }
  .cat { font-size: 11px; letter-spacing: 2px; font-weight: 700; }
  .item h2 { margin: 6px 0 0; }
  .item h2 a { font-size: 21px; font-weight: 700; line-height: 1.4; color: #1a1a1a; text-decoration: none; }
  .subhead { font-size: 13px; line-height: 1.7; color: #8a5a1a; margin: 8px 0 0; font-style: italic; }
  .teaser { font-size: 14px; line-height: 1.9; color: #44474a; margin: 12px 0 0; }
  .links { margin: 14px 0 0; }
  .links .read { font-size: 12px; letter-spacing: 1px; color: #1a1a1a; text-decoration: none; border-bottom: 1px solid #c9a54a; padding-bottom: 2px; }
  .links .src { font-size: 12px; color: #8a8578; text-decoration: none; margin-left: 14px; }
  .thin-rule { border-top: 1px solid #ece7dc; margin: 28px 44px; height: 1px; }

  .foot { padding: 0 44px 36px; font-size: 12px; line-height: 1.9; color: #8a8578; }
  .foot a { color: #8a5a1a; }
  a { color: inherit; }
</style>
</head>
<body>

{% set TAGCOLOR = {'廠商動態':'#8a5a1a','技術發表':'#2a6a5a','研究成果':'#2a6a5a','法規與給付':'#6a3a6a','臨床應用':'#8a2a3a','財務與併購':'#3a5a8a','台灣動態':'#8a5a1a','其他':'#5a6672'} %}

<div class="card">
  <div class="head">
    {# 2026-09-18 補頂部導覽：這頁原本沒有任何回上層連結，從 archive 或
       首頁點進來會困在這層（使用者反映）。 #}
    <p class="head-nav"><a href="/">← 回首頁</a><a href="/archive">出刊紀錄</a></p>
    <div class="head-row">
      <div>
        <p class="eyebrow">DELTA · NBDMD</p>
        <p class="brand">{{ newsletter_name }}</p>
      </div>
      <div class="meta">{{ issue_date }}<br>第 {{ issue_no }} 期 · 共 {{ total_articles }} 則</div>
    </div>
  </div>

  {% if tldr and tldr.get('headline') %}
  <div class="tldr" style="padding-top: 18px;">
    <div class="tldr-item" style="font-size: 15px; color: #1a1a1a; font-weight: 500;">{{ tldr.headline }}</div>
  </div>
  {% endif %}

  {% if tldr %}
  <div class="tldr">
    <p class="tldr-title">本期導讀</p>
    {% for group, label in [('trends','趨勢'), ('highlights','重點'), ('observations','觀察')] %}
    {% if tldr.get(group) %}
    <p class="tldr-group">{{ label }}</p>
    {% for item in tldr[group] %}<div class="tldr-item">— {{ item }}</div>{% endfor %}
    {% endif %}
    {% endfor %}
  </div>
  <div class="rule"></div>
  {% endif %}

  {% for topic in topics %}
  <div class="item">
    <div class="item-inner">
      <div class="num">{{ "%02d"|format(loop.index) }}</div>
      <div class="item-body">
        <div class="cat" style="color: {{ TAGCOLOR.get(topic.primary_tag, '#5a6672') }};">{{ topic.primary_tag }}</div>
        <h2><a href="/issues/{{ issue_id }}/topics/{{ topic.id }}">{{ topic.chosen_headline }}</a></h2>
        {% if topic.chosen_subhead %}<div class="subhead">{{ topic.chosen_subhead }}</div>{% endif %}
        {% if topic.card_summary %}<div class="teaser">{{ topic.card_summary.text }}</div>{% endif %}
        <div class="links">
          <a class="read" href="/issues/{{ issue_id }}/topics/{{ topic.id }}">閱讀全文 →</a>
          {% if topic.source_url %}<a class="src" href="{{ topic.source_url }}" target="_blank" rel="noopener noreferrer">原文出處</a>{% endif %}
          {% if topic.needs_review %}<span class="src" title="這則的自動自檢信心偏低">⚠ 自檢信心偏低，請以原文為準</span>{% endif %}
        </div>
      </div>
    </div>
  </div>
  <div class="thin-rule"></div>
  {% endfor %}

  {% if tldr and tldr.get('editorial') %}
  <div class="tldr" style="padding-bottom: 8px;">
    <p class="tldr-title">主編觀察</p>
    {% for para in tldr.editorial %}
    <p class="teaser" style="margin-top: 12px;">{{ para }}</p>
    {% endfor %}
    <p class="tldr-item" style="margin-top: 14px; color: #8a8578;">本欄由 AI 依本期報導綜合而成，屬推測性觀點，請以各篇原文為準。</p>
  </div>
  <div class="thin-rule"></div>
  {% endif %}

  <div class="foot">
    完整版與歷史期數：<a href="http://TWTP1NB3422.delta.corp:8002">http://TWTP1NB3422.delta.corp:8002</a> ·
    <a href="/archive">出刊紀錄</a> · <a href="/sources">來源清單</a><br>
    本報每日自動掃描的完整來源見〈來源清單〉。摘要與導讀由 AI 生成並經
    自動自檢，每則均附原文出處，請以原文為準。僅供台達內部參考，請勿外流。
  </div>
</div>

{# 彈層閱讀（2026-09-18）：跟 topic_module_list.html.jinja 同一段，兩邊
   模板沒有繼承機制，改這裡記得同步那邊。點文章開 iframe 彈層、pushState
   換網址、Esc／點背景／上一頁都會關。 #}
<div class="reader-overlay" id="reader" hidden>
  <div class="reader-panel">
    <button class="reader-close" aria-label="關閉">✕</button>
    <iframe class="reader-frame" id="reader-frame" title="全文"></iframe>
  </div>
</div>
<style>
  .reader-overlay { position: fixed; inset: 0; background: rgba(24,30,36,0.55); z-index: 50; }
  .reader-panel { position: absolute; top: 3vh; left: 50%; transform: translateX(-50%);
                  width: min(720px, 94vw); height: 94vh; background: #fff;
                  box-shadow: 0 12px 48px rgba(0,0,0,0.35); }
  .reader-close { position: absolute; top: 0; right: 0; z-index: 2; border: 0; cursor: pointer;
                  background: rgba(24,30,36,0.85); color: #fff; font-size: 1rem; line-height: 1;
                  padding: 0.55em 0.75em; }
  .reader-frame { width: 100%; height: 100%; border: 0; display: block; }
</style>
<script>
(function () {
  var overlay = document.getElementById('reader');
  var frame = document.getElementById('reader-frame');
  function openReader(url) {
    frame.src = url;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    history.pushState({ reader: true }, '', url);
  }
  function closeReader(viaHistory) {
    overlay.hidden = true;
    frame.src = 'about:blank';
    document.body.style.overflow = '';
    if (!viaHistory) history.back();
  }
  document.addEventListener('click', function (e) {
    var a = e.target.closest ? e.target.closest('a') : null;
    if (!a) return;
    var href = a.getAttribute('href') || '';
    if (/^\/issues\/\d+\/topics\/\d+/.test(href)) {
      e.preventDefault();
      openReader(href);
    }
  });
  overlay.addEventListener('click', function (e) { if (e.target === overlay) closeReader(false); });
  overlay.querySelector('.reader-close').addEventListener('click', function () { closeReader(false); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !overlay.hidden) closeReader(false);
  });
  window.addEventListener('popstate', function () { if (!overlay.hidden) closeReader(true); });
})();
</script>

</body>
</html>
