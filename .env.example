# 複製這份檔案為 .env 並填入實際值（.env 不會進版控）

# LLM API（用於內容摘要與生成）。目前走的是台達內部 Clawith 包出來的
# Qwen 模型端點，OpenAI 相容介面，不是 Anthropic 官方 API，所以變數名稱
# 也不叫 ANTHROPIC_*，避免搞混。
LLM_API_KEY=

# 必填：Clawith Qwen 端點的 base URL（跟 Clawith 那邊確認正確值）
LLM_BASE_URL=

# 必填：要打的 model 名稱（跟 Clawith 那邊確認，例如 qwen-plus / qwen-max 這類）
NEWSLETTER_MODEL=

# 選填：寫作（generation/topic_generate.py）／自檢（review/topic_selfcheck.py）
# 這兩步 prompt 帶整篇來源全文，token 量遠大於標籤／打分，免費層 TPM 容易爆，
# 可以指定一顆限額較寬鬆的小模型單獨扛這兩步。沒設就沿用 NEWSLETTER_MODEL。
NEWSLETTER_WRITING_MODEL=

# 選填：自檢（review/topic_selfcheck.py）審查用的模型。自檢本來就是獨立呼叫、
# 不帶生成階段的對話歷史，但終究跟寫作同一顆模型查自己的作業，可以指定
# 另一顆模型當審查員。沒設就退回 NEWSLETTER_WRITING_MODEL（沒設 WRITING 的話
# 再退回 NEWSLETTER_MODEL）。
NEWSLETTER_REVIEW_MODEL=

# 選填：知識圖譜功能（三元組抽取 + Neo4j）。本機開發用
# `docker compose up -d neo4j` 起一個單機 instance，預設值對應
# docker-compose.yml 裡的設定。NEO4J_URI 沒填的話
# scripts/ingest_topics.py 的建圖步驟會印警告並跳過，不會讓
# 抓取/聚類/標籤/打分中斷。
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Reddit API（用於抓取科技社群熱門討論，需先在 https://www.reddit.com/prefs/apps 註冊一個 script 類型 app）
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=delta-ai-newsletter/0.1 by u/your_reddit_username
